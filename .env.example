PORT=8000
TEST_PORT=8001
NODE_ENV=development

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_PATH=./data/mandi_pos.db

# Primary runtime database (MySQL/MariaDB)
LOC_DB_HOST=localhost
LOC_DB_PORT=3306
LOC_DB_USER=your_db_user
LOC_DB_PASS=your_db_password
LOC_DB_NAME=pos
LOC_DB_POOL_MIN=2
LOC_DB_POOL_MAX=10

# Legacy aliases used by the standalone migrator scripts
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=pos

CORS_ORIGIN=http://localhost:8002,http://localhost:4200,http://localhost:3000
